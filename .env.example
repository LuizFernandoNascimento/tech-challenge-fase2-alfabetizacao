# Copie este arquivo para .env e preencha com os valores do seu projeto GCP
GCP_PROJECT_ID=
GCP_REGION=southamerica-east1
GCS_BUCKET_RAW=

BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold
# Staging na multi-região US: a fonte pública da Base dos Dados vive em
# US e o BigQuery não mistura locations no mesmo job. Usado para trazer
# os microdados de aluno (~3,87M linhas) via CTAS + cópia cross-region.
BQ_DATASET_BRONZE_US=bronze_us
# Histórico dos resultados dos testes de qualidade.
BQ_DATASET_QUALITY=quality

PUBSUB_TOPIC_ALUNOS=dados-alunos-stream
PUBSUB_SUBSCRIPTION_ALUNOS=dados-alunos-stream-sub

GOOGLE_APPLICATION_CREDENTIALS=
